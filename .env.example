# Server only. Do not commit .env or share credentials.
LLM_PROVIDER=gigachat
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
LLM_BASE_URL=https://api.giga.chat/v1
LLM_MODEL=GigaChat-3-Ultra
# Optional absolute path to the trusted CA PEM, outside the website directory.
GIGACHAT_CA_BUNDLE=

# Local Docker database only. Choose separate local passwords.
DOCKER_MYSQL_ROOT_PASSWORD=
DOCKER_MYSQL_PASSWORD=
